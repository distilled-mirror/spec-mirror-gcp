            "subscription": {
              "description": "The subscription to delete.",
              "location": "path",
              "type": "string",
              "required": true,
              "pattern": "^.*$"
            }
          },
          "scopes": [
            "https://www.googleapis.com/auth/cloud-platform",
            "https://www.googleapis.com/auth/pubsub"
          ]
        }
