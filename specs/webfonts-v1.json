          },
          "description": "The available variants for the font.",
          "type": "array"
        },
        "category": {
          "type": "string",
          "description": "The category of the font."
        },
        "lastModified": {
          "type": "string",
          "description": "The date (format \"yyyy-MM-dd\") the font was modified for the last time."
        },
        "axes": {
