  "description": "A simple Google Example Library API.",
  "baseUrl": "https://libraryagent.googleapis.com/",
  "rootUrl": "https://libraryagent.googleapis.com/",
  "icons": {
    "x32": "http://www.google.com/images/icons/product/search-32.gif",
