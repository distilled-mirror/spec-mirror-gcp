                },
                "parent": {
                  "required": true,
                  "description": "Required. The name of the shelf whose books we'd like to list.",
                  "type": "string",
                  "location": "path",
                  "pattern": "^shelves/[^/]+$"
                }
              },
              "flatPath": "v1/shelves/{shelvesId}/books",
