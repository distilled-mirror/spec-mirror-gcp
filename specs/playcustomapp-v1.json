    },
    "access_token": {
      "type": "string",
      "description": "OAuth access token.",
      "location": "query"
    }
  },
  "rootUrl": "https://playcustomapp.googleapis.com/",
  "description": "API to create and publish custom Android apps",
  "servicePath": "",
  "batchPath": "batch"
}