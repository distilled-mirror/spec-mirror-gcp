    "x32": "http://www.google.com/images/icons/product/search-32.gif"
  },
  "ownerDomain": "google.com",
  "version": "v1",
  "name": "playcustomapp",
  "mtlsRootUrl": "https://playcustomapp.mtls.googleapis.com/",
