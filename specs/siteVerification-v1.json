          },
          "parameterOrder": [
            "verificationMethod"
          ]
        },
        "getToken": {
          "id": "siteVerification.webResource.getToken",
          "description": "Get a verification token for placing on a website or domain.",
          "request": {
            "$ref": "SiteVerificationWebResourceGettokenRequest"
          },
