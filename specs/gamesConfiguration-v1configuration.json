        },
        "value": {
          "description": "The string value.",
          "type": "string"
        }
      },
      "type": "object",
      "description": "A localized string resource."
    },
    "LeaderboardConfigurationListResponse": {
      "id": "LeaderboardConfigurationListResponse",
      "type": "object",
      "description": "A ListConfigurations response.",
      "properties": {
        "items": {
          "items": {
